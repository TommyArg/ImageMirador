<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="galleryRoot"
      style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.dsf.imagemirador.Controller.GalleryController">

    <!-- coso para estirar/contraer la galería -->
    <StackPane fx:id="dragHandle"
               minHeight="16.0"
               prefHeight="16.0"
               style="-fx-background-color: rgba(0, 0, 0, 0.85); -fx-cursor: n-resize;">
        <Region minHeight="4.0" maxHeight="4.0" prefHeight="4.0" prefWidth="50.0"
                style="-fx-background-color: #cccccc; -fx-background-radius: 5;"/>
    </StackPane>

    <ScrollPane fx:id="galleryScrollPane"
                fitToHeight="true"
                fitToWidth="true"
                pannable="true"
                style="-fx-background: transparent; -fx-background-color: rgba(0, 0, 0, 0.6);"
                VBox.vgrow="ALWAYS">
        <content>
            <TilePane fx:id="tilePane"
                      alignment="CENTER"
                      hgap="10.0"
                      vgap="10.0"
                      style="-fx-background-color: transparent;"
                      tileAlignment="CENTER">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
            </TilePane>
        </content>
    </ScrollPane>
</VBox>
